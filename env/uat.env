# ===== GB SMTP Service — UAT =====
# UAT uses its own sub-domains (uatmail.<domain>) so it never competes with PRD
# for the real domains' MX records. Test mail sent from UAT comes from e.g.
# test@uatmail.goldnpay.in, never from a real production address.

ENV_NAME=uat

MAIL_HOSTNAME=mail-uat.goldbucks.org

# Public IPv4 of the UAT server. Leave empty to auto-detect.
PUBLIC_IP=

ACME_EMAIL=deamteam312@gmail.com

POSTMASTER_ADDRESS=postmaster@uatmail.goldbucks.org

MAILBOXES_FILE=config/uat/mailboxes.txt
ALIASES_FILE=config/uat/aliases.txt

# Pinned to match PRD. To test an upgrade, bump here first, then in prd.env.
DMS_VERSION=15.1.0

# UAT should run on its own VPS/IP (only one server per IP can receive on port 25).
# To run UAT on the SAME host as PRD for send-only testing, change these to e.g.
# 2525 / 2465 / 2587 / 2993 — UAT then cannot receive mail from the internet.
BIND_IP=0.0.0.0
PORT_SMTP=25
PORT_SMTPS=465
PORT_SUBMISSION=587
PORT_IMAPS=993

SSL_TYPE=letsencrypt
LETSENCRYPT_DIR=/etc/letsencrypt

DMARC_POLICY=none
ENABLE_CLAMAV=0
ENABLE_FAIL2BAN=1
RSPAMD_GREYLISTING=0
MAILBOX_SIZE_LIMIT=1073741824   # 1 GB per mailbox
MESSAGE_SIZE_LIMIT=26214400
LOG_LEVEL=debug
TZ=Asia/Kolkata

BACKUP_DIR=/var/backups/gbsmtp
BACKUP_RETENTION_DAYS=7
