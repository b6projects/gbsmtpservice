# ===== GB SMTP Service — PRODUCTION =====
# No secrets in this file. Mailbox passwords are generated by scripts/setup.sh
# and written to $DATA_ROOT/secrets/credentials.txt (outside the repo).

ENV_NAME=prd

# Where mail, accounts, DKIM keys, passwords and the DNS sheet are stored.
# Must be OUTSIDE the code checkout (e.g. a Jenkins workspace can be wiped).
# This folder IS the PRD data folder: $DATA_ROOT/{mail-data,mail-state,mail-logs,config,secrets}
DATA_ROOT=/root/projects/gbsmtpservice/prd

# Certificate method: auto (nginx plugin if nginx is on port 80, else standalone) | nginx | standalone
CERT_METHOD=auto

# Mail server hostname. Needs an A record -> PUBLIC_IP and the PTR (reverse DNS)
# of PUBLIC_IP set to this name in the VPS provider's panel.
MAIL_HOSTNAME=mail.goldbucks.org

# Public IPv4 of the PRD server (used to print DNS records). Leave empty to auto-detect.
PUBLIC_IP=

# Email used for Let's Encrypt registration and expiry notices
ACME_EMAIL=deamteam312@gmail.com

POSTMASTER_ADDRESS=postmaster@goldbucks.org

# Files (relative to project root) listing the mailboxes and aliases to create
MAILBOXES_FILE=config/prd/mailboxes.txt
ALIASES_FILE=config/prd/aliases.txt

# docker-mailserver image tag (pinned). Upgrade UAT first, then PRD.
# (scripts/build.sh records the exact digest in release.lock).
DMS_VERSION=15.1.0

# Standard ports (PRD must own port 25 on its IP to receive mail)
BIND_IP=0.0.0.0
PORT_SMTP=25
PORT_SMTPS=465
PORT_SUBMISSION=587
PORT_IMAPS=993

SSL_TYPE=letsencrypt
LETSENCRYPT_DIR=/etc/letsencrypt

DMARC_POLICY=none          # start with none -> quarantine -> reject once reports are clean
ENABLE_CLAMAV=0            # set 1 if the server has >= 4 GB RAM
ENABLE_FAIL2BAN=1
RSPAMD_GREYLISTING=0
MAILBOX_SIZE_LIMIT=5368709120   # 5 GB per mailbox (0 = unlimited)
MESSAGE_SIZE_LIMIT=26214400     # 25 MB per message
LOG_LEVEL=info
TZ=Asia/Kolkata

# Backups
BACKUP_DIR=/root/projects/gbsmtpservice/backups
BACKUP_RETENTION_DAYS=14
